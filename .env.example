# Copiez ce fichier en .env.local et remplissez les valeurs.
# Sur Vercel : Project Settings > Environment Variables.

# URL publique du site (SEO, sitemap, partages réseaux sociaux)
NEXT_PUBLIC_SITE_URL=https://tourismtour.com

# Envoi des formulaires par email (ex : Gmail avec un "mot de passe d'application")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse-expediteur@gmail.com
SMTP_PASS=mot-de-passe-application
# Adresse qui reçoit les demandes des visiteurs
CONTACT_EMAIL=contact@tourismtour.com
